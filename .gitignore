# ==========================================
# 1. FRONTEND (Next.js & Node.js)
# ==========================================
# Dependencies
frontend/node_modules/
# Next.js build output
frontend/.next/
frontend/out/
frontend/build/
# Vercel local output
frontend/.vercel/
# Debug logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ==========================================
# 2. BACKEND & DATA PIPELINE (Python & FastAPI)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
backend/venv/
backend/env/
data_pipeline/venv/
data_pipeline/env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Pytest / Coverage logs
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ==========================================
# 3. DATABASE & LOCAL DATA
# ==========================================
# Local SQLite databases (if used for testing)
*.sqlite3
*.db

# Scraped raw data (Avoid committing large files to Git)
data_pipeline/raw_data/*.csv
data_pipeline/raw_data/*.json
# Keep the folder structure but ignore the content
!data_pipeline/raw_data/.gitkeep

# ==========================================
# 4. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ==========================================
# NEVER commit your actual passwords or API keys!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 5. OS & IDE SPECIFIC FILES
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs (VS Code, PyCharm, Cursor)
.vscode/
.idea/
*.swp