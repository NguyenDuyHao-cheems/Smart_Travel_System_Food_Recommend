# ==========================================
# 1. FRONTEND (Next.js & Node.js)
# ==========================================
# Dependencies
Frontend/node_modules/
# Next.js build output
Frontend/.next/
Frontend/out/
Frontend/build/
# Vercel local output
Frontend/.vercel/
# Debug logs
Frontend/npm-debug.log*
Frontend/yarn-debug.log*
Frontend/yarn-error.log*
Frontend/build.log

# ==========================================
# 2. BACKEND & DATA PIPELINE (Python & FastAPI)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
**/venv/
**/env/
**/pyvenv.cfg
core_backend/venv/
ai_engine/venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Pytest / Coverage logs
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ==========================================
# 3. DATABASE & LOCAL DATA
# ==========================================
# Local SQLite databases
*.sqlite3
*.db

# Scraped raw data/local files (Avoid committing large files)
Data_Pipeline/raw_data/*.csv
Data_Pipeline/raw_data/*.json
local_files/
**/__pycache__/

# Keep the folder structure but ignore the content
!Data_Pipeline/raw_data/.gitkeep

# ==========================================
# 4. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ==========================================
# NEVER commit your actual passwords or API keys!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 5. OS & IDE SPECIFIC FILES
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs (VS Code, PyCharm, Cursor)
.vscode/
.idea/
*.swp
docs/PLAN.md

# Specialized build & test files
*.tsbuildinfo
.vitest/
coverage/
