# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Authentication ────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI Engine Connection ──────────────────────────────────────────────────────
# Local development: http://localhost:8001
# Docker Compose:    http://ai_engine:8001  (overridden in docker-compose.yml)
AI_ENGINE_BASE_URL=http://localhost:8001

# gRPC Config (Local development: localhost:50051)
ENABLE_GRPC=true
AI_ENGINE_GRPC_TARGET=localhost:50051

# ── Vector Dimensions ────────────────────────────────────────────────────────
VECTOR_DIM=768