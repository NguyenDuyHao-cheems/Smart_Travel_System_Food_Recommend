# AI Engine Settings
AI_SERVICE_PORT= # Internal port for the AI service, e.g., 8001

# NLP Model settings
PHOBERT_MODEL_NAME= # Standard PhoBERT model from HuggingFace (base/large)
HF_TOKEN= # HuggingFace token for rate limiting

# LambdaMART Ranking Engine
LAMBDAMART_MODEL_PATH= # Path to LambdaMART model file, e.g., models/lambdamart.lgb


# Gemini Settings for Query Parsing
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL_NAME=gemini-flash-latest  # or gemini-2.0-flash, gemini-2.5-flash, etc.